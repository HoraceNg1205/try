<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600" prefWidth="900" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="library.controllers.LibrarianDashboardController">

    <!-- Top header + Logout -->
    <top>
        <Label style="-fx-font-size:24px; -fx-padding:10" text="Librarian Dashboard" BorderPane.alignment="CENTER" />
    </top>

    <!-- Main tabs -->
    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">

            <!-- 1) Pending Approvals -->
            <Tab text="Pending Approvals">
                <BorderPane>
                    <!-- Table of pending books -->
                    <center>
                        <TableView fx:id="pendingBooksTable" prefHeight="400" prefWidth="850">
                            <columns>
                                <TableColumn fx:id="titleColumn" text="Title" prefWidth="200"/>
                                <TableColumn fx:id="authorColumn" text="Author" prefWidth="150"/>
                                <TableColumn fx:id="abstractColumn" text="Abstract" prefWidth="400"/>
                                <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="100"/>
                            </columns>
                        </TableView>
                    </center>

                    <!-- Action buttons -->
                    <bottom>
                        <HBox alignment="CENTER" spacing="20">
                            <padding>
                                <Insets top="10" bottom="10" left="10" right="10"/>
                            </padding>
                            <Button fx:id="viewButton" text="View" onAction="#handleViewBook" prefWidth="120"/>
                            <Button fx:id="approveButton" text="Approve" onAction="#handleApproveBook" prefWidth="120"/>
                            <Button fx:id="rejectButton" text="Reject" onAction="#handleRejectBook" prefWidth="120"/>
                        </HBox>
                    </bottom>
                </BorderPane>
            </Tab>

            <!-- 2) Manage Users -->
            <Tab text="Manage Users">
            </Tab>

            <!-- 3) My Profile -->
            <Tab text="My Profile">
            </Tab>

            <!-- 4) Borrowed Books Report -->
            <Tab text="Borrowed Books">
            </Tab>

            <!-- 5) Published Books Report -->
            <Tab text="Published Books">
            </Tab>

        </TabPane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="20">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <Button onAction="#handleLogout" prefHeight="40" prefWidth="150" text="Logout" />
        </HBox>
    </bottom>
</BorderPane>

